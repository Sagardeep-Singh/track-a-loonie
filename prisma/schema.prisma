generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ImportBatchStatus {
  ACTIVE
  UNDONE
}

enum ReminderCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

enum BudgetMode {
  LIMITS
  ZERO_BASED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// nullable: users who sign up via Google have no password
  passwordHash String?
  /// null = unverified. Google sign-up sets this immediately (Google already
  /// verified the address); credentials sign-up leaves it null until the
  /// emailed link is clicked. Never gates access — see
  /// lib/services/emailVerification.ts and the 2026-09-17 codebase review's
  /// "Signup has no email verification" finding for the accepted-risk
  /// reasoning behind that choice.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  categoryRules      CategoryRule[]
  importBatches      ImportBatch[]
  reimbursementLinks ReimbursementLink[]

  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  aiSettings             UserAiSettings?
  budgetSettings         UserBudgetSettings?
  categoryAssignments    CategoryAssignment[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
}

/// One row per user, replaced (not appended) on every (re)send — sending a
/// new link invalidates any earlier one, so a stale email in an inbox can't
/// be used after a newer one was requested. The raw token is only ever in
/// the emailed link; `tokenHash` is its SHA-256 hex digest, same reasoning
/// as never storing a plaintext password.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Same shape and reasoning as `EmailVerificationToken`: one row per user,
/// replaced on every request so only the newest emailed link works, and only
/// the SHA-256 of the raw token is stored. Deleted once used. See
/// lib/services/passwordReset.ts.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id              String      @id @default(cuid())
  userId          String
  name            String
  type            AccountType
  startingBalance Decimal     @default(0) @db.Decimal(12, 2)
  /// day of month (1-28) a credit card statement closes on; only meaningful when type is CREDIT_CARD
  statementDay    Int?
  /// zero-based budgeting only: whether this account's balance feeds Ready to
  /// Assign. Defaults to true; the migration and createAccount turn it off for
  /// SAVINGS. Ignored everywhere else in the app.
  onBudget        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  importBatches ImportBatch[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  categoryRules CategoryRule[]
  assignments   CategoryAssignment[]

  @@unique([userId, name])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String?
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  date          DateTime
  payee         String?
  note          String?
  importBatchId String?
  /// marks an INCOME transaction on a credit card account as a payment toward
  /// the previous statement's balance, so it's excluded from the current
  /// statement period's credit/debit/net totals
  isPayment     Boolean         @default(false)
  /// marks one leg of a transfer between two of the user's own accounts (e.g.
  /// the checking-side EXPENSE and the card-side INCOME of a card payment), so
  /// neither leg is counted as real income or spending in any aggregate
  isTransfer    Boolean         @default(false)
  /// soft correlation id shared by both legs of one matched transfer pair; not
  /// a foreign key — it exists for display, debugging, and future unlinking
  transferMatchId String?
  /// marks an EXPENSE the user expects to be paid back for (work expense, split
  /// bill). Mutually exclusive with isTransfer/isPayment. Invariant:
  /// isReimbursable === true <=> reimbursementExpectedAmount !== null
  isReimbursable  Boolean         @default(false)
  /// how much of this expense is expected back; <= amount. equal = fully
  /// reimbursable, less = partially. null when !isReimbursable
  reimbursementExpectedAmount Decimal? @db.Decimal(12, 2)
  /// set only by the manual "mark fully reimbursed" override. A derived COMPLETE
  /// (linked total >= expected) reverts to PARTIAL/PENDING if links shrink; a
  /// manual one only reverts when the user explicitly un-marks it
  reimbursementCompletedAt DateTime?
  skippedAt     DateTime?
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reimbursementExpenseLinks ReimbursementLink[] @relation("ReimbursementExpense")
  reimbursementIncomeLinks  ReimbursementLink[] @relation("ReimbursementIncome")

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([importBatchId])
  @@index([transferMatchId])
  @@index([userId, isReimbursable])
}

/// one income transaction contributing `amount` toward one reimbursable
/// expense. Many-to-many with a per-link amount: one income can partially
/// reimburse several expenses, one expense can be paid back over several
/// incomes. Unlike Transaction.transferMatchId (a soft correlation id), this
/// is a real join table with real FKs because it carries its own money.
model ReimbursementLink {
  id                   String   @id @default(cuid())
  userId               String
  expenseTransactionId String
  incomeTransactionId  String
  amount               Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense Transaction @relation("ReimbursementExpense", fields: [expenseTransactionId], references: [id], onDelete: Restrict)
  income  Transaction @relation("ReimbursementIncome", fields: [incomeTransactionId], references: [id], onDelete: Restrict)

  @@unique([expenseTransactionId, incomeTransactionId])
  @@index([userId])
  @@index([incomeTransactionId])
}

/// one CSV commit; groups the transactions it created so the whole import can be
/// listed in history and undone as a unit. `filenameNormalized` is the lowercased,
/// trimmed `filename` and is what duplicate-import detection compares on.
model ImportBatch {
  id                 String            @id @default(cuid())
  userId             String
  accountId          String
  filename           String
  filenameNormalized String
  status             ImportBatchStatus @default(ACTIVE)
  /// count of rows the client submitted in the commit body (pre-dedupe); used for
  /// the secondary duplicate-import signal, so unrelated dedupe skips don't skew it
  rowCount           Int
  /// rows actually inserted (post row-level dedupe)
  importedCount      Int
  /// rows dropped by row-level dedupe at commit time
  skippedDuplicates  Int
  /// min/max transaction date across the submitted rows; secondary dup signal
  dateFrom           DateTime
  dateTo             DateTime
  createdAt          DateTime          @default(now())
  undoneAt           DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, accountId, filenameNormalized])
  @@index([userId, createdAt])
}

/// month stored as YYYYMM (e.g. 202603) to keep budgets sortable and
/// unambiguous without carrying a day-of-month
model Budget {
  id          String  @id @default(cuid())
  userId      String
  categoryId  String
  month       Int
  limitAmount Decimal @db.Decimal(12, 2)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

/// per-user budgeting mode. A row exists only once the user changes the mode
/// in Settings — absence of a row means LIMITS, the default for every
/// existing and new user, so no backfill migration is needed.
model UserBudgetSettings {
  id            String     @id @default(cuid())
  userId        String     @unique
  mode          BudgetMode @default(LIMITS)
  /// YYYYMM month zero-based math starts from; set the first time ZERO_BASED
  /// is enabled and kept when switching back to LIMITS, so re-enabling
  /// resumes instead of starting over
  zbbStartMonth Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// money assigned to a category for one YYYYMM month in zero-based mode.
/// Unlike Budget it does not repeat into later months: leftovers carry
/// forward through the derived `available`, not through this row. May be
/// negative (money moved out of a category funded in an earlier month).
model CategoryAssignment {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      Int
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/// per-user reminder settings. A row exists only once the user opts in from
/// Settings — absence of a row means reminders are off, which is the default
/// for every existing and new user, so no backfill migration is needed.
model NotificationPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  enabled         Boolean         @default(false)
  cadence         ReminderCadence @default(DAILY)
  /// UTC instant a reminder was last actually pushed; opens the window the
  /// next tick's activity gate compares Transaction/ImportBatch activity
  /// against, and enforces the cadence floor so a user isn't nagged twice
  /// in one period
  lastSentAt      DateTime?
  /// UTC instant of the last daily tick that evaluated this row, sent or
  /// not; bookkeeping only, makes a stalled cron visible without digging
  /// through logs
  lastEvaluatedAt DateTime?
  createdAt       DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

/// per-user BYOK settings for AI-assisted categorization. A row exists only
/// once the user saves a key from Settings — absence of a row means the
/// feature is off, which is the default for every existing and new user, so
/// no backfill migration is needed. Deliberately excluded from data export
/// (see lib/services/userData.ts) and preserved across data import.
model UserAiSettings {
  id       String     @id @default(cuid())
  userId   String     @unique
  provider AiProvider
  /// AES-256-GCM ciphertext of the provider API key, packed as
  /// "v1:<iv-b64>:<tag-b64>:<ciphertext-b64>" by lib/crypto/secrets.ts.
  /// Never returned by any service, never logged, never exported.
  encryptedApiKey String
  /// last 4 chars of the plaintext key, stored separately so Settings can
  /// render "sk-…a1b2" without ever decrypting. Display-only.
  keyLast4        String
  /// set when a probe call to the provider last succeeded. null means the key
  /// was persisted during a provider outage and is unverified.
  verifiedAt      DateTime?
  /// provider model id the user picked for suggestions (e.g.
  /// "claude-3-5-haiku-latest", "gpt-4o-mini"). Saving a key or switching
  /// provider rewrites this column in the same write, so it starts out
  /// belonging to the `provider` in the same row. Not enforced afterward: the
  /// model-only PATCH path (`updateAiModel`) writes this column without a
  /// provider check, so a stale client could in principle write a value that
  /// no longer matches — self-heals via `AiModelRejectedError` at the next
  /// suggest call rather than being validated here. null = not yet picked:
  /// the next successful models-list fetch backfills it with the first entry.
  /// Existing rows start null, so no backfill migration is needed.
  modelId         String?
  /// opt-in: include Transaction.note in the prompt. Default off.
  sendNote        Boolean   @default(false)
  /// opt-in: include Transaction.amount in the prompt. Default off.
  sendAmount      Boolean   @default(false)
  /// set the first time the user acknowledges the data-disclosure panel;
  /// the suggest endpoint refuses to run while null.
  disclosureAcceptedAt DateTime?
  /// UTC calendar date (YYYYMMDD int, same idiom as Budget.month) the
  /// suggest counter belongs to; rolls the counter over without a cron job
  suggestCountDate     Int?
  /// suggest calls made on suggestCountDate. DB-backed because serverless is
  /// multi-instance: an in-memory limiter would not limit.
  suggestCount         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// one browser/device push registration. A user may hold several (phone,
/// laptop, work browser) and every non-expired one receives each reminder.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  /// push service endpoint URL; globally unique per browser registration,
  /// so re-subscribing the same browser under a different account reassigns
  /// the row instead of erroring
  endpoint   String    @unique
  /// client public key (p256dh) from the browser subscription, base64url
  p256dh     String
  /// client auth secret from the browser subscription, base64url
  auth       String
  /// user-agent at subscribe time, so Settings can label the device
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// set when the push service returned 404/410 for this endpoint; kept
  /// rather than deleted so Settings can show the device as expired
  disabledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

/// fixed-window counter backing lib/services/rateLimit.ts. Not tied to a
/// user — `key` is whatever the caller is limiting by (a lowercased email,
/// an IP address), so it also covers signup/login attempts against an email
/// with no account yet. Rows are pruned opportunistically by the service on
/// every check, not by a cron job, so this table never needs its own job.
model RateLimitBucket {
  id          String   @id @default(cuid())
  /// what's being limited, e.g. "login:email", "login:ip", "signup:ip"
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([scope, key, windowStart])
  @@index([windowStart])
}

/// ordered keyword rule for auto-categorization: lower priority value wins
/// when a payee/note contains matchText (case-insensitive)
model CategoryRule {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  matchText  String
  priority   Int    @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}
