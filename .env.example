DATABASE_URL="postgresql://user:password@localhost:5432/budget?schema=public"

# optional: pooled connection URL the app uses at runtime instead of DATABASE_URL.
# Set this on serverless deploys (Vercel) so each function instance doesn't open
# its own pool of direct connections and exhaust the database's limit. The Vercel
# Prisma Postgres integration (connected with the DATABASE_ prefix) injects it as
# a prisma+postgres:// URL. DATABASE_URL must stay the direct URL, since
# migrations (`prisma migrate deploy`) use it.
# DATABASE_PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
# Signs session cookies. 32+ random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-value"
# The app's public URL. Also the base for links in emails (lib/http/appUrl.ts).
# On Vercel it can stay unset: emails then use the production domain
# (VERCEL_PROJECT_PRODUCTION_URL) or, on previews, the branch URL
# (VERCEL_BRANCH_URL), falling back to the deployment URL (VERCEL_URL).
BETTER_AUTH_URL="http://localhost:3000"

# optional: enables "Continue with Google" on the login/sign-up pages.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials,
# with authorized redirect URI <origin>/api/auth/callback/google. Left unset, the
# Google option is hidden and email/password sign-up still works.
# AUTH_GOOGLE_ID="your-client-id"
# AUTH_GOOGLE_SECRET="your-client-secret"

# optional: enables the reminders card in Settings and the daily reminder cron.
# Generate a key pair with `npx web-push generate-vapid-keys`. The public key is
# used both in the browser (pushManager.subscribe) and on the server (web-push),
# so it is one NEXT_PUBLIC_ var rather than two that could drift. VAPID_SUBJECT is
# the mailto:/https: contact the Web Push spec requires. Left unset, Settings says
# reminders aren't available on this deployment and the cron run is a no-op.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:you@example.com"

# optional: enables the "AI categorization" card in Settings and the per-row
# "Suggest with AI" action in the Categorize queue. 32 random bytes, base64:
# `openssl rand -base64 32`. It encrypts each user's bring-your-own provider API
# key at rest (AES-256-GCM, with the userId as additional authenticated data).
# Server-only — never NEXT_PUBLIC_, never returned by any API response, never in
# a data export. Left unset, Settings says AI suggestions aren't available on
# this deployment and the suggest endpoint answers 503. Rotating it without
# migrating stored keys makes every saved key unreadable — see
# docs/runbooks/rotate-secret-encryption-key.md.
# SECRET_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# test-only: override where the Anthropic/OpenAI adapters send their outbound
# calls, so the e2e suite can point them at a local fixture server. Read once at
# module load from deploy config only — never from request input, so this is not
# a user-reachable SSRF surface. Leave unset in any real deployment; the
# adapters default to the real provider APIs.
# AI_ANTHROPIC_BASE_URL="http://127.0.0.1:4599"
# AI_OPENAI_BASE_URL="http://127.0.0.1:4599"

# optional: enables sending the email-verification link on signup and the
# resend button on the unverified-email banner. Get an API key from
# https://app.brevo.com/settings/keys/api. BREVO_SENDER_EMAIL must be a
# verified sender in your Brevo account. Left unset, signup still works —
# accounts are just created unverified with no way to verify them, same
# accept-the-risk posture as before this was added.
# BREVO_API_KEY="your-brevo-api-key"
# BREVO_SENDER_EMAIL="you@example.com"
# BREVO_SENDER_NAME="Track a Loonie"

# test-only: override where the Brevo client sends its outbound calls, same
# reasoning as AI_ANTHROPIC_BASE_URL/AI_OPENAI_BASE_URL above.
# BREVO_BASE_URL="http://127.0.0.1:4599"

# test-only: disables the login/signup rate limiter (lib/auth/config.ts,
# lib/auth/actions.ts). The e2e suite logs in as the same dev user across many
# specs, far more attempts per run than the limiter is meant to catch. Set
# only by playwright.config.ts's webServer env — leave unset in any real
# deployment, and never set it from request input.
# E2E_DISABLE_RATE_LIMIT="1"

# bearer token Vercel Cron sends on its scheduled call to /api/cron/reminders, and
# what you pass by hand to test it. Unset, the cron route fails closed with a 500
# rather than running unauthenticated.
# CRON_SECRET="replace-with-a-random-value"

# used only by `npm run prisma:bootstrap-admin`, an optional convenience for
# seeding a known dev account — not required, anyone can sign up from /signup
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# optional: where the in-app "Source code" link (AGPLv3 section 13) points.
# Unset, it points to the upstream repository. If you deploy a modified version,
# set this to your modified source, as the AGPL requires.
# SOURCE_CODE_URL="https://github.com/you/your-fork"
